<?xml version="1.0" encoding="utf-8"?>
<!-- Real Count: reads which app is open and counts full-screen short-video swipes.
     Not an accessibility tool (isAccessibilityTool=false): declared to Google Play with a prominent disclosure. -->
<!-- Volume Up+Down: Snapy is the target of Android's accessibility shortcut. With
     flagRequestAccessibilityButton (targetSdk > 29) the shortcut calls the button callback instead of
     toggling the service. No key-event filtering (canRequestFilterKeyEvents stays false: ColorOS kills
     services that filter keys). typeViewClicked: the reel lock re-checks the feed after a tap. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagRequestAccessibilityButton"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:canPerformGestures="false"
    android:notificationTimeout="100"
    android:isAccessibilityTool="false"
    android:description="@string/accessibility_description"
    android:summary="@string/accessibility_summary" />

{
  "_meta": {
    "schema_version": 1,
    "language": "hi-Deva",
    "description": "Hindi in Devanagari script. Devanagari words are not ASCII word characters, so these patterns never use \\b next to Devanagari; they use whitespace/punctuation lookaheads instead."
  },
  "flags": {"ignore_case": true},
  "macros": {
    "DEV_NAME": "(?<name>[^\\s,]+(?: [^\\s,]+)?)",
    "DEV_SEP": "(?:\\s*[,:]\\s*|\\s+(?:कि|बोलो|लिखो|कहो)\\s+|\\s+)",
    "DEV_END": "(?=$|[\\s,.!?।])"
  },
  "domains": {
    "phone": [
      {"id": "whatsapp.ko", "order": 1010, "intent": "whatsapp", "pattern": "^{{DEV_NAME}} को (?:व्हाट्सएप|व्हाट्सऐप|वॉट्सऐप|whatsapp|मैसेज)(?: (?:करो|कर दो|भेजो|भेज दो))?{{DEV_SEP}}(?<text>.+)$"},
      {"id": "sms.ko", "order": 1020, "intent": "sms", "pattern": "^{{DEV_NAME}} को (?:एसएमएस|sms|टेक्स्ट)(?: (?:करो|कर दो|भेजो|भेज दो))?{{DEV_SEP}}(?<text>.+)$"},
      {"id": "call.ko", "order": 1030, "intent": "call", "pattern": "^{{DEV_NAME}} को (?:कॉल|काल|फ़ोन|फोन|call)(?: (?:करो|कर दो|लगाओ|लगा दो|मिलाओ))?$"},
      {"id": "timer.ka_timer", "order": 1040, "intent": "timer", "pattern": "^(?<n>\\d+|[^\\s\\d]+) ?(?<unit>सेकंड|मिनट|घंटे|घंटा) का टाइमर (?:लगाओ|लगा दो|सेट करो)$"},
      {"id": "navigate.rasta", "order": 1050, "intent": "navigate", "pattern": "^(?<place>.+?) (?:का|के) (?:रास्ता|रूट) (?:बताओ|दिखाओ)$"},
      {"id": "torch.state", "order": 1060, "intent": "torch", "pattern": "^(?:टॉर्च|फ्लैशलाइट) (?<state>जलाओ|चालू करो|ऑन करो|बंद करो|बंद)$"}
    ],
    "phone_yes": [
      {"id": "deva", "pattern": "^(?:हाँ|हां|हा|जी|जी हाँ|ठीक है|भेज दो|कर दो){{DEV_END}}"}
    ],
    "phone_no": [
      {"id": "deva", "pattern": "^(?:नहीं|नही|मत|रहने दो|रुको|कैंसल){{DEV_END}}"}
    ],
    "assistant_yes": [
      {"id": "deva", "pattern": "^(?:हाँ|हां|हा|जी|ठीक है|चलो|कर दो){{DEV_END}}"}
    ],
    "assistant_no": [
      {"id": "deva", "pattern": "^(?:नहीं|नही|मत|अभी नहीं){{DEV_END}}"}
    ],
    "assistant_stop": [
      {"id": "deva", "pattern": "^(?:चुप|बस|रुको|रुक)[\\s.,!?।]*$"}
    ],
    "question_or_creative": [
      {"id": "deva_ask", "pattern": "(?:^|\\s)(?:समझाओ|बताओ|क्या है|कैसे)(?=$|[\\s,.!?।])"}
    ],
    "script_devanagari": [
      {"id": "range", "pattern": "[\\u0900-\\u097F]"}
    ],
    "unfinished": [
      {"id": "deva", "pattern": "(?:^|\\s)(?:और|या|की|के|का|को|में|से|तो|फिर|पर|पे|जो)\\s*$"}
    ],
    "transliteration": {
      "खोलो": "kholo", "खोल": "khol", "बंद": "band", "करो": "karo", "कर": "kar", "दो": "do", "चलाओ": "chalao",
      "चला": "chala", "रोको": "roko", "नीचे": "neeche", "ऊपर": "upar", "आवाज़": "awaaz", "आवाज": "awaaz",
      "बढ़ाओ": "badhao", "बढाओ": "badhao", "कम": "kam", "स्क्रॉल": "scroll", "यूट्यूब": "youtube",
      "गाना": "gaana", "अगला": "agla", "पिछला": "pichla", "टैब": "tab", "वापस": "wapas", "जाओ": "jao",
      "सर्च": "search", "क्रोम": "chrome", "म्यूट": "mute", "रुको": "ruko", "बजाओ": "bajao", "पर": "par",
      "पे": "pe", "में": "mein", "को": "ko", "और": "aur", "थोड़ा": "thoda", "ज़्यादा": "zyada"
    },
    "phone_device": [
      {"id": "phone_device.devanagari.capture_stop", "order": 12, "intent": "capture_stop", "pattern": "^(?:वीडियो|विडियो|रिकॉर्डिंग) (?:बंद करो|रोको)$"},
      {"id": "phone_device.devanagari.capture_video_camera", "order": 25, "intent": "capture_video", "pattern": "^(?<camera>फ्रंट|बैक|सेल्फी) कैमरा (?:से )?(?:वीडियो|विडियो) (?:बनाओ|रिकॉर्ड करो|लो)$"},
      {"id": "phone_device.devanagari.capture_video", "order": 26, "intent": "capture_video", "pattern": "^(?:वीडियो|विडियो) (?:बनाओ|रिकॉर्ड करो|शुरू करो)$"},
      {"id": "phone_device.devanagari.selfie", "order": 35, "intent": "capture_photo", "pattern": "^(?<camera>सेल्फी) (?:खींचो|लो|क्लिक करो)$"},
      {"id": "phone_device.devanagari.capture_photo", "order": 36, "intent": "capture_photo", "pattern": "^(?:फोटो|फ़ोटो|तस्वीर) (?:खींचो|लो|क्लिक करो)$"},
      {"id": "phone_device.devanagari.sos_stop", "order": 42, "intent": "sos_stop", "pattern": "^(?:एसओएस|इमरजेंसी|अलार्म) बंद करो$|^मैं (?:ठीक|सेफ) हू[ँं]$"},
      {"id": "phone_device.devanagari.sos_call", "order": 52, "intent": "sos_call", "pattern": "^(?:इमरजेंसी|एम्बुलेंस|पुलिस|112) (?:को )?(?:कॉल|फोन|फ़ोन) करो$"},
      {"id": "phone_device.devanagari.sos", "order": 62, "intent": "sos", "pattern": "^(?:बचाओ|मदद करो)$"},
      {"id": "phone_device.devanagari.meeting_start", "order": 72, "intent": "meeting_start", "pattern": "^(?:मैं )?मीटिंग में हू[ँं](?: नोट्स? (?:लो|लेना|बनाओ))?$"},
      {"id": "phone_device.devanagari.meeting_stop", "order": 82, "intent": "meeting_stop", "pattern": "(?:^|\\s)मीटिंग (?:खत्म|ख़त्म|समाप्त) (?:हो गई|हुई)(?=$|[\\s,.!?।])|(?:^|\\s)नोट्स सेव करो(?=$|[\\s,.!?।])"}
    ]
  }
}

    "selectors": {
      "_comment": "Fixed scripts' targets (view IDs / descriptions). Updated here when apps change.",
      "whatsapp_send": [
        "com.whatsapp:id/send",
        "com.whatsapp.w4b:id/send",
        "Send"
      ]
    },
    "realcount": {
      "reel_detection": {
        "_comment": "A reel/short is counted when a full-screen vertical feed changes page. feed_min_height_fraction: the scrolled view must be at least this tall (fraction of the screen); page_scroll_fraction: on API 28+ without item indices, a scroll of at least this fraction of the screen height is a page change. swipe_gap_ms: when the app reports neither (Instagram ViewPager2), a burst of scroll events after this much quiet is one swipe = one page.",
        "feed_min_height_fraction": 0.6,
        "page_scroll_fraction": 0.5,
        "swipe_gap_ms": 450
      },
      "creator": {
        "_comment": "Screens that are creating/messaging, not consuming (window class or view id contains a keyword). feed_view_ids, when listed, are the only scroll sources that count. Check on current app versions.",
        "keywords": [
          "camera",
          "capture",
          "creation",
          "editor",
          "composer",
          "direct",
          "thread",
          "inbox",
          "upload",
          "share"
        ],
        "apps": {
          "com.instagram.android": {
            "feed_view_ids": [
              "com.instagram.android:id/clips_viewer_view_pager",
              "com.instagram.android:id/list",
              "list",
              "swipeable_tab_view_pager"
            ],
            "keywords": [
              "direct",
              "camera",
              "creation",
              "clips_editor"
            ]
          },
          "com.google.android.youtube": {
            "feed_view_ids": [
              "com.google.android.youtube:id/reel_recycler"
            ],
            "keywords": [
              "upload",
              "camera",
              "editor"
            ]
          }
        }
      },
      "health": {
        "stale_after_s": 180
      },
      "long_video_apps": ["com.google.android.youtube"],
      "reel_lock": {
        "_comment": "Hard lock / 80% deflector tunables (ReelLock.kt <-> lib/realcount/reel_lock.dart ReelLockRules): extra_reels per '5 more' grant, extra_per_day grants, breath_s before a grant, deflect_at fraction of the limit, deflect_bubble_ms, max_backs before escalating to the app's start screen within bounce_window_ms, bounce_latency_ms budget. Feed pager ids for the lock: creator.apps.<pkg>.feed_view_ids.",
        "extra_reels": 5,
        "extra_per_day": 1,
        "breath_s": 10,
        "deflect_at": 0.8,
        "deflect_bubble_ms": 3000,
        "max_backs": 2,
        "bounce_window_ms": 2500,
        "bounce_latency_ms": 150
      }
    }

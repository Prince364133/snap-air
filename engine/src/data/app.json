{
  "_comment": "Product data for Snapy: download sources, model names, timings and limits. Change values here, not in code. User preferences live in settings.json (see src/config.py).",
  "server": {
    "host": "localhost",
    "port": 8765,
    "max_message_mb": 8
  },
  "ollama": {
    "host": "http://127.0.0.1:11434",
    "installer_url": "https://ollama.com/download/OllamaSetup.exe",
    "installer_file": "OllamaSetup.exe",
    "installer_args": [
      "/VERYSILENT",
      "/NORESTART",
      "/SUPPRESSMSGBOXES"
    ],
    "install_timeout_s": 900
  },
  "speech_models": {
    "repo_url": "https://huggingface.co/Systran/faster-whisper-{name}/resolve/main/",
    "files": [
      "config.json",
      "tokenizer.json",
      "vocabulary.txt",
      "model.bin"
    ],
    "english": {
      "fast": "tiny.en",
      "balanced": "tiny.en",
      "accurate": "small.en"
    },
    "multilingual": {
      "fast": "base",
      "balanced": "base",
      "accurate": "small"
    }
  },
  "voice_model": {
    "url": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/",
    "files": [
      "voices-v1.0.bin",
      "kokoro-v1.0.int8.onnx"
    ]
  },
  "native_voices": {
    "base_url": "https://huggingface.co/rhasspy/piper-voices/resolve/main/"
  },
  "setup_size_estimates": {
    "speech": 140000000,
    "voice": 120000000,
    "runtime": 1100000000,
    "brain": 1400000000
  },
  "vision": {
    "install_model": "qwen3.5:4b",
    "local_models": [
      "qwen3.5:4b",
      "qwen3.5:2b",
      "qwen2.5vl:3b",
      "gemma3:4b",
      "qwen2.5vl:7b"
    ],
    "min_gpu_vram_gb": 4,
    "max_image_side": 1024
  },
  "web": {
    "youtube_search": "https://www.youtube.com/results?search_query=",
    "connectivity_check": "https://www.google.com"
  },
  "cloud": {
    "_comment": "Cloud brains. 'models' is tried in order: when a provider says a model doesn't exist (retired, or not on this account) Snapy moves to the next one. Per model: token_param (default max_tokens), sampling (false = never send temperature), min_max_tokens (room for reasoning), extra (merged into the request body). Last checked 2026-11-15.",
    "providers": {
      "gemini": {
        "label": "Google Gemini",
        "desc": "Fast, low-cost Gemini Flash-Lite",
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "key_url": "aistudio.google.com",
        "models": [
          {"id": "gemini-3.5-flash-lite", "sampling": false},
          {"id": "gemini-2.5-flash-lite"}
        ]
      },
      "openai": {
        "label": "OpenAI",
        "desc": "Fast, lightweight GPT from OpenAI",
        "base_url": "https://api.openai.com/v1",
        "key_url": "platform.openai.com",
        "json_mode": true,
        "models": [
          {"id": "gpt-6-luna", "token_param": "max_completion_tokens", "sampling": false,
           "extra": {"reasoning_effort": "none"}},
          {"id": "gpt-4o-mini"}
        ]
      },
      "anthropic": {
        "label": "Anthropic Claude",
        "desc": "Fast, low-cost Claude Haiku",
        "base_url": "https://api.anthropic.com/v1",
        "key_url": "console.anthropic.com",
        "models": [
          {"id": "claude-haiku-5-5", "sampling": false, "min_max_tokens": 1024,
           "extra": {"output_config": {"effort": "low"}}}
        ]
      },
      "grok": {
        "label": "xAI Grok",
        "desc": "Fast conversational Grok from xAI",
        "base_url": "https://api.x.ai/v1",
        "key_url": "console.x.ai",
        "models": [
          {"id": "grok-4.20-0309-non-reasoning"},
          {"id": "grok-4.3"}
        ]
      },
      "groq": {
        "label": "Groq (ultra-fast LPU)",
        "desc": "Near-instant open models on Groq",
        "base_url": "https://api.groq.com/openai/v1",
        "key_url": "console.groq.com",
        "json_mode": true,
        "models": [
          {"id": "openai/gpt-oss-20b", "min_max_tokens": 1024, "extra": {"reasoning_effort": "low"}},
          {"id": "openai/gpt-oss-120b", "min_max_tokens": 1024, "extra": {"reasoning_effort": "low"}}
        ]
      },
      "mistral": {
        "label": "Mistral AI",
        "desc": "Efficient European models",
        "base_url": "https://api.mistral.ai/v1",
        "key_url": "console.mistral.ai",
        "json_mode": true,
        "models": [{"id": "mistral-small-latest"}]
      },
      "deepseek": {
        "label": "DeepSeek",
        "desc": "DeepSeek Flash",
        "base_url": "https://api.deepseek.com/v1",
        "key_url": "platform.deepseek.com",
        "json_mode": true,
        "models": [{"id": "deepseek-flash"}]
      },
      "openrouter": {
        "label": "OpenRouter",
        "desc": "One key, routed to a good model per question",
        "base_url": "https://openrouter.ai/api/v1",
        "key_url": "openrouter.ai/keys",
        "json_mode": true,
        "headers": {"HTTP-Referer": "https://snapy.live", "X-Title": "Snapy AI"},
        "models": [{"id": "openrouter/auto"}]
      },
      "perplexity": {
        "label": "Perplexity",
        "desc": "Search-grounded answers",
        "base_url": "https://api.perplexity.ai",
        "key_url": "perplexity.ai/settings/api",
        "models": [{"id": "sonar"}]
      },
      "compatible": {
        "label": "Custom (OpenAI-compatible / self-hosted)",
        "desc": "Your own server, vLLM, or any OpenAI-compatible endpoint",
        "base_url": "https://api.openai.com/v1",
        "json_mode": true,
        "custom": true,
        "models": []
      }
    }
  },
  "timings": {
    "call_offer_cooldown_s": 1800,
    "welcome_back_gap_s": 10800,
    "recently_active_s": 600,
    "snooze_default_min": 10,

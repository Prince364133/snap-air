---
import '../styles/global.css';
import { SITE, NAV, FOOTER, RELEASE } from '../config';

interface Crumb { name: string; href: string }
interface Props {
  title: string;              // page title without the brand suffix (home passes the full title)
  description: string;
  image?: string;
  crumbs?: Crumb[];           // breadcrumb trail after "Home"
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
}
const { title, description, image = '/og.png', crumbs = [], schema = [], noindex = false, fullTitle = false, ogType = 'website' } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const path = Astro.url.pathname;

const org = {
  '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url,
  logo: `${SITE.url}/icon-512.png`, email: SITE.email.support,
};
const website = { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url, publisher: { '@id': `${SITE.url}/#org` }, inLanguage: 'en-IN' };
const breadcrumb = crumbs.length ? [{
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href,
  })),
}] : [];
const graph = { '@context': 'https://schema.org', '@graph': [org, website, ...breadcrumb, ...schema] };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <meta name="color-scheme" content="light dark" />
  <meta name="application-name" content={SITE.name} />
  <meta name="author" content={SITE.company} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
  <meta property="og:locale" content={SITE.locale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" id="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <img class="logo-light" src="/logo-black.svg" alt="" width="28" height="28" />
        <img class="logo-dark" src="/logo-white.svg" alt="" width="28" height="28" />
        {SITE.name}
      </a>
      <nav class="nav" aria-label="Main">
        {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="btn btn-primary btn-sm header-cta" href="/download/">Download</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="top">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

  <main id="main">
    {crumbs.length > 0 && (
      <div class="wrap" style="padding-top:28px">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
          </ol>
        </nav>
      </div>
    )}
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="brand" href="/">
            <img class="logo-light" src="/logo-black.svg" alt="" width="28" height="28" />
            <img class="logo-dark" src="/logo-white.svg" alt="" width="28" height="28" />
            {SITE.name}
          </a>
          <p class="muted" style="margin-top:12px;max-width:280px">{SITE.tagline}. Talk to your PC; the AI runs on it.</p>
          <p class="fine" style="margin-top:12px">Version {RELEASE.version} · Windows 10 &amp; 11</p>
        </div>
        {FOOTER.map((col) => (
          <div>
            <h2>{col.title}</h2>
            <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.company}. All rights reserved. Snapy is proprietary software.</span>
        <span>Made in India · <a href={`mailto:${SITE.email.support}`}>{SITE.email.support}</a></span>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const h = document.querySelector('.site-header'), b = h && h.querySelector('.menu-btn');
      if (b) b.addEventListener('click', () => { const o = h.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      els.forEach((e) => io.observe(e));
    })();
  </script>
</body>
</html>

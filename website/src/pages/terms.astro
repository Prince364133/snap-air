---
import Legal from '../layouts/Legal.astro';
import { SITE } from '../config';
const toc: [string, string][] = [
  ['agreement', 'Agreement'], ['service', 'The service'], ['eligibility', 'Eligibility'], ['use', 'Acceptable use'],
  ['ai', 'AI output & automation'], ['third-party', 'Third-party services'], ['ip', 'Intellectual property'],
  ['warranty', 'Disclaimer'], ['liability', 'Limitation of liability'], ['termination', 'Termination'],
  ['law', 'Governing law'], ['changes', 'Changes'], ['contact', 'Contact'],
];
---
<Legal seoTitle="Terms of Service" title="Terms of Service" crumb="Terms of service" path="/terms/" toc={toc}
  description="The terms that apply when you use the Snapy website and the Snapy AI assistant for Windows.">
  <h2 id="agreement">Agreement</h2>
  <p>These Terms of Service (“Terms”) govern your use of the {SITE.domain} website and the Snapy desktop application (together, the “Service”), provided by {SITE.company} (“we”, “us”). By downloading, installing or using the Service you agree to these Terms and to the <a href="/eula/">Snapy License Agreement</a>. If you do not agree, do not use the Service.</p>

  <h2 id="service">The service</h2>
  <p>Snapy is an AI assistant for Windows that runs primarily on your own computer. Features may change as we improve the product. Some features depend on your hardware, your settings, or third-party services you choose to connect.</p>

  <h2 id="eligibility">Eligibility</h2>
  <p>You must be at least 13 years old and old enough to enter a binding agreement where you live, or use the Service with a parent’s or guardian’s permission.</p>

  <h2 id="use">Acceptable use</h2>
  <p>You agree not to use the Service to:</p>
  <ul>
    <li>break the law, or record, transcribe or monitor people without the notice or consent the law requires;</li>
    <li>access computers, accounts or data you are not authorised to access;</li>
    <li>harass, defraud or harm others, or infringe others’ rights;</li>
    <li>reverse engineer, resell or redistribute the Service except as the EULA allows.</li>
  </ul>
  <p>You are responsible for how you use meeting notes. Tell participants when you take notes, and follow your organisation’s policies and local law.</p>

  <h2 id="ai">AI output &amp; automation</h2>
  <p>Snapy uses AI models that can be wrong; check important information before relying on it. When you ask Snapy to act on your computer — clicking, typing, pressing keys, opening apps — you remain responsible for those actions. Snapy asks for confirmation before actions it identifies as irreversible, but cannot guarantee it recognises every such action. Don’t rely on Snapy for safety-critical, medical, legal or financial decisions.</p>

  <h2 id="third-party">Third-party services</h2>
  <p>If you connect a cloud AI provider (such as Google Gemini or OpenAI) or use web features, those services’ own terms and privacy policies apply. You are responsible for any costs on your own API keys.</p>

  <h2 id="ip">Intellectual property</h2>
  <p>Snapy, its software, design, name and logo are owned by {SITE.company}. Snapy is proprietary software, licensed — not sold — under the <a href="/eula/">EULA</a>. Content you create with Snapy, such as notes, tasks and memories, belongs to you.</p>

  <h2 id="warranty">Disclaimer</h2>
  <p>The Service is provided “as is” and “as available”, without warranties of any kind, express or implied, to the fullest extent permitted by law.</p>

  <h2 id="liability">Limitation of liability</h2>
  <p>To the fullest extent permitted by law, {SITE.company} is not liable for indirect, incidental, special, consequential or punitive damages, or for lost data, profits or business, arising from your use of the Service. Nothing here limits liability that cannot be limited by law.</p>

  <h2 id="termination">Termination</h2>
  <p>You can stop using the Service at any time by uninstalling it. We may end access if you materially breach these Terms.</p>

  <h2 id="law">Governing law</h2>
  <p>These Terms are governed by the laws of {SITE.jurisdiction}, and its courts have jurisdiction, without affecting mandatory consumer rights where you live.</p>

  <h2 id="changes">Changes</h2>
  <p>We may update these Terms. We will change the date above and, for material changes, give notice on this website or in the release notes.</p>

  <h2 id="contact">Contact</h2>
  <p><a href={`mailto:${SITE.email.legal}`}>{SITE.email.legal}</a></p>
</Legal>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, RELEASE } from '../config';

const schema = [{
  '@type': 'SoftwareApplication',
  name: SITE.name,
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'UtilitiesApplication',
  softwareVersion: RELEASE.version,
  fileSize: `${RELEASE.sizeMB}MB`,
  downloadUrl: new URL(RELEASE.downloadUrl, SITE.url).href,
  publisher: { '@id': `${SITE.url}/#org` },
}];
---
<Base title="Download Snapy for Windows 10 & 11" description={`Download Snapy ${RELEASE.version} for Windows — one ${RELEASE.sizeMB} MB installer that sets itself up automatically, including the right on-device AI model for your PC.`} crumbs={[{ name: 'Download', href: '/download/' }]} schema={schema}>
  <section class="dl-hero">
    <div class="wrap center">
      <span class="orb dl-orb" style="--size:96px" aria-hidden="true"></span>
      <h1>Download Snapy</h1>
      <p class="lead" style="margin:16px auto 32px;max-width:620px">One installer. It sets itself up, checks your PC and installs the AI that runs best on it.</p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn btn-primary btn-lg" href={RELEASE.downloadUrl} download><Icon name="windows" size={20} />Download for Windows</a>
      </div>
      <p class="fine" style="margin-top:16px">Version {RELEASE.version} · {RELEASE.dateLabel} · {RELEASE.sizeMB} MB · {RELEASE.file}</p>
      <p class="fine">{RELEASE.os}</p>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid-3">
        <div class="card"><div class="icon i-blue"><Icon name="download" /></div><h2 class="h3">1. Run the installer</h2><p>Open <code>{RELEASE.file}</code> from your Downloads folder and follow the short installer. No administrator rights needed — it installs for your Windows user.</p></div>
        <div class="card"><div class="icon i-purple"><Icon name="cpu" /></div><h2 class="h3">2. Snapy sets itself up</h2><p>On first launch Snapy checks your RAM, CPU and graphics, installs its local AI runtime and downloads the model that fits your PC — in the background.</p></div>
        <div class="card"><div class="icon i-green"><Icon name="chat" /></div><h2 class="h3">3. Say hello</h2><p>A one-minute setup asks your name and work hours. Then say “Snapy, start my day”.</p></div>
      </div>

      <div class="grid grid-2" style="margin-top:20px">
        <div class="callout warn"><span class="dot"></span><div><p><strong>Seeing “Windows protected your PC”?</strong></p><p class="muted">New apps can trigger Microsoft Defender SmartScreen until they build a download reputation. Click <strong>More info → Run anyway</strong>, or check the file’s fingerprint below first. <a href="/install/#smartscreen">Why this happens</a></p></div></div>
        <div class="callout"><span class="dot"></span><div><p><strong>Verify your download (optional)</strong></p><p class="muted">In PowerShell: <code>Get-FileHash .\{RELEASE.file}</code></p><p class="muted" style="word-break:break-all">SHA-256: <code>{RELEASE.sha256}</code></p></div></div>
      </div>
    </div>
  </section>

  <section class="alt section-tight">
    <div class="wrap">
      <div class="grid grid-2 dl-info">
        <div>
          <h2 class="h2s">What gets installed</h2>
          <ul class="list">
            <li>The Snapy app, its voice and speech recognition (about {RELEASE.sizeMB} MB, inside the installer)</li>
            <li>A local AI runtime and one AI model sized for your PC (about 1–3 GB, downloaded on first launch)</li>
            <li>Optional extras only when you turn them on: native Indian voices (~63 MB each), a local vision model</li>
          </ul>
          <p class="fine" style="margin-top:14px">Everything installs into your user profile. Uninstall any time from Windows Settings → Apps.</p>
        </div>
        <div>
          <h2 class="h2s">Before you start</h2>
          <ul class="list">
            <li>Windows 10 (version 1903 or later) or Windows 11, 64-bit</li>
            <li>8 GB RAM minimum — 16 GB recommended</li>
            <li>About 4 GB of free disk space</li>
            <li>A microphone (a webcam only for hand gestures)</li>
            <li>Internet for the first setup; after that Snapy works offline</li>
          </ul>
          <a href="/system-requirements/" class="more" style="display:inline-block;margin-top:14px;font-weight:600">Full system requirements →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap center">
      <p class="muted">Need help installing? Read the <a href="/install/">step-by-step install guide</a> or <a href="/support/">contact support</a>.</p>
      <p class="fine" style="margin-top:10px">By downloading you agree to the <a href="/eula/">License Agreement</a> and <a href="/terms/">Terms of Service</a>. Snapy is proprietary software.</p>
    </div>
  </section>
</Base>

<style>
  .dl-hero { padding-top: clamp(56px, 8vw, 96px); padding-bottom: 48px; position: relative; overflow: hidden; }
  .dl-hero::before { content: ''; position: absolute; left: 50%; top: -260px; width: 900px; height: 700px; transform: translateX(-50%); z-index: -1; opacity: .5;
    background: radial-gradient(closest-side at 40% 50%, rgb(var(--orb-1) / .5), transparent), radial-gradient(closest-side at 60% 50%, rgb(var(--orb-2) / .45), transparent); filter: blur(60px); }
  .dl-orb { margin: 0 auto 28px; box-shadow: 0 20px 60px rgb(var(--orb-1) / .45); }
  .btn-lg { height: 56px; padding: 0 32px; font-size: 18px; }
  .h3 { font-size: 22px; margin-bottom: 8px; }
  .h2s { font-size: 26px; margin-bottom: 16px; }
  .list { display: grid; gap: 10px; padding-left: 20px; color: var(--text-2); }
</style>

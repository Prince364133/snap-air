  points={[
    { icon: 'window', c: 'i-blue', t: 'Reads the window', d: 'Windows describes every control — its name, type and position. Snapy uses that first, so clicks are exact and instant, with no screenshots.' },
    { icon: 'eye', c: 'i-purple', t: 'Reads the pixels when it must', d: 'Apps that don’t describe themselves fall back to Windows’ built-in text recognition (about half a second), then a vision model for icons and pictures.' },
    { icon: 'cursor', c: 'i-teal', t: 'Understands “top left”', d: '“Second”, “last”, “bottom right”, “upar wala” — positions are worked out from the real layout, in reading order.' },
